  "models": [
    {
      "id": "eng",
      "display_name": "English (tessdata_fast)",
      "file": "eng.traineddata",
      "size_mb": 4,
      "license": "Apache-2.0",
      "bundled": true,
      "default": true
    },
    {
      "id": "tessdata_fast",
      "display_name": "Other languages (tessdata_fast, one file per language)",
      "size_mb": 3,
      "license": "Apache-2.0",
      "bundled": false,
      "url": "https://github.com/tesseract-ocr/tessdata_fast"
    }
  ],
  "disk_required_mb": 40,
  "ram_required_mb": 256,
  "config_schema": {
    "fields": [
      {
        "key": "straight_quotes",
        "type": "bool",
        "label": "Straight quotes",
        "default": true,
        "help": "Write “curly” quotes as \"straight\" ones, as most subtitle files do."
      }
    ]
  }
}
