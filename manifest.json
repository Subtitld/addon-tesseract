{
  "manifest_version": 1,
  "id": "tesseract",
  "version": "26.11.1",
  "display_name": "Tesseract OCR",
  "summary": "Reads picture subtitles (DVD VobSub, Blu-ray PGS) as text with Tesseract 5.5, so Subtitld can open them. Offline, CPU only. English is included; any of 100 other languages downloads once, when first needed (1-12 MB).",
  "author": "Subtitld",
  "homepage": "https://github.com/Subtitld/addon-tesseract",
  "license": "Apache-2.0",
  "executable": "bin/tesseract-addon",
  "protocol": 1,
  "startup_timeout_sec": 30,
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "tasks": [
    "ocr.recognize"
  ],
  "compute": "cpu",
  "languages": [
